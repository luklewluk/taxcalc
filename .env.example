# Skopiuj do `.env.local` (rozwój) lub ustaw jako prawdziwe zmienne środowiskowe (produkcja).
#
#   cp .env.example .env.local
#
# APP_SECRET wygenerujesz np. poleceniem:
#   php -r 'echo bin2hex(random_bytes(16)), PHP_EOL;'

# `prod` na produkcji, `dev` lokalnie.
APP_ENV=prod

# Losowy, tajny ciąg znaków. Używany wyłącznie do podpisywania tokenów CSRF i ciasteczka sesji.
APP_SECRET=

# Lista dozwolonych nazw hostów (wyrażenie regularne) - zabezpiecza przed atakami Host header.
# Przykład: '^kalkulator\.example\.com$'
TRUSTED_HOSTS=''

# Bazowy adres aplikacji (używany m.in. przez polecenia CLI generujące URL-e).
DEFAULT_URI=https://kalkulator.example.com

# Publiczne API kursów walut Narodowego Banku Polskiego. Nie wymaga żadnych kluczy.
NBP_API_BASE_URL=https://api.nbp.pl/api/

# Adres repozytorium pokazywany w stopce strony.
APP_REPOSITORY_URL=https://github.com/luklewluk/pit-stock-calc
