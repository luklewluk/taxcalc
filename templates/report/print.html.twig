<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>Raport PIT-38 za {{ report.taxYear }}</title>
    <script src="{{ asset('js/theme.js') }}"></script>
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    <link rel="stylesheet" href="{{ asset('css/print.css') }}" media="print">
</head>
<body class="printable">
<main class="container container--workbench">
    <header class="print-header">
        <h1>Raport pomocniczy do PIT-38 za {{ report.taxYear }}</h1>
        <p class="muted">Wersja tylko do odczytu. Dokument nie został nigdzie zapisany.</p>
    </header>

    {% include '_partials/workbench_summary.html.twig' with {expanded: true} %}

    <section class="section">
        <h2>Logiczne transakcje wejściowe FIFO ({{ trade_rows|length }})</h2>
        {% if trade_rows is not empty %}
            <div class="table-wrapper"><table class="table table--detail">
                <thead><tr><th>Broker / pula</th><th>Symbol</th><th>Nazwa / kraj</th><th>Data i czas</th><th>Kierunek</th><th>Liczba</th><th>Cena/szt.</th><th>Total</th><th>Prowizja</th><th>AutoFX</th><th>Źródło</th></tr></thead>
                <tbody>{% for row in trade_rows %}<tr><td>{{ row.broker }} / {{ row.pool }}</td><td>{{ row.symbol }}</td><td>{{ row.name }} / {{ row.country }}</td><td>{{ row.date }} {{ row.time }}</td><td>{{ row.side }}</td><td>{{ row.quantity }}</td><td>{{ row.unit_price == '' ? '—' : row.unit_price ~ ' ' ~ row.price_currency }}</td><td>{{ row.total }} {{ row.currency }}</td><td>{{ row.commission ?: '—' }}</td><td>{{ row.autofx ?: '—' }}</td><td>{{ row.source }}</td></tr>{% endfor %}</tbody>
            </table></div>
        {% endif %}
        <h2>Dopasowania FIFO</h2>
        {% include '_partials/fifo_matches.html.twig' %}
    </section>

    <section class="section">
        <h2>Dywidendy ({{ dividend_rows|length }})</h2>
        {% if report.dividends.dividends is not empty %}
            <div class="table-wrapper"><table class="table table--detail"><thead><tr><th>Instrument / kraj</th><th>Data</th><th>Brutto</th><th>Kurs NBP / data</th><th>Brutto PLN</th><th>Stawka umowna</th><th>Pobrany PLN</th><th>Podatek PL</th><th>Odliczenie KIS</th><th>Odliczenie NSA</th><th>Różnica odliczeń</th><th>KIS do zapłaty</th><th>NSA do zapłaty</th></tr></thead><tbody>
            {% for item in report.dividends.dividends %}<tr><th>{{ item.dividend.name }} / {{ item.dividend.countryCode }}</th><td>{{ item.dividend.date|date('Y-m-d') }}</td><td>{{ item.gross.original|money_with_currency }}</td><td>{{ item.gross.rate }} / {{ item.gross.rateDate ? item.gross.rateDate|date('Y-m-d') : 'PLN' }}</td><td>{{ item.gross.pln|money(2) }}</td><td>{{ item.treatyPercent is null ? '—' : item.treatyPercent ~ '%' }}</td><td>{{ item.withheldTax.pln|money(2) }}</td><td>{{ item.polishTax|money(2) }}</td><td>{{ item.conservative.creditableTax|money(2) }}</td><td>{{ item.nsa.creditableTax|money(2) }}</td><td>{{ item.creditDifference|money(2) }}</td><td>{{ item.conservative.taxDue|money(2) }}</td><td>{{ item.nsa.taxDue|money(2) }}</td></tr>{% endfor %}
            </tbody></table></div>
        {% endif %}
    </section>

    <section class="section">
        <h2>Samodzielne opłaty rachunkowe ({{ fee_rows|length }})</h2>
        {% if fee_rows is not empty %}
            <div class="table-wrapper"><table class="table table--compact"><thead><tr><th>Opis</th><th>Kategoria</th><th>Data waluty</th><th>Kwota</th><th>Korekta</th><th>Uwzględniona</th><th>Źródło</th></tr></thead><tbody>
            {% for row in fee_rows %}<tr><th>{{ row.description }}</th><td>{{ row.category }}</td><td>{{ row.value_date }}</td><td>{{ row.amount }} {{ row.currency }}</td><td>{{ row.correction == '1' ? 'tak' : 'nie' }}</td><td>{{ row.included == '1' ? 'tak' : 'nie' }}</td><td>{{ row.source }}</td></tr>{% endfor %}
            </tbody></table></div>
        {% endif %}
    </section>

    <footer class="print-footer"><p class="disclaimer">Zastrzeżenie: {{ disclaimer }}</p></footer>
    <p class="actions no-print">
        <button type="button" class="button button--primary" data-action="print" hidden>Drukuj</button>
        <span data-role="print-fallback">Drukowanie w przeglądarce: Ctrl+P lub ⌘+P.</span>
        <a class="button button--plain" href="{{ path('app_calculator') }}">Wróć do kalkulatora</a>
    </p>
</main>
<script src="{{ asset('js/app.js') }}" defer></script>
</body>
</html>
