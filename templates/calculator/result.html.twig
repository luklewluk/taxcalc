{% extends 'base.html.twig' %}

{% block title %}Wynik rozliczenia {{ report.taxYear }} — {{ app_name }}{% endblock %}

{% block container_class %}container container--wide{% endblock %}

{% block progress %}
    {% include '_partials/steps.html.twig' with {current: 3} only %}
{% endblock %}

{% block body %}
    <p class="eyebrow">Rozliczenie gotowe</p>
    <h1>Twój wynik za {{ report.taxYear }}</h1>

    {% include '_partials/report_summary.html.twig' %}

    <section class="section section--tight download-band" aria-labelledby="pobierz">
        <div class="download-band__text">
            <h2 id="pobierz">Zabierz to ze sobą</h2>
            <p class="quiet download-note">
                Raport powstaje w momencie kliknięcia i idzie prosto do Ciebie — na serwerze nie zostaje żaden plik.
            </p>
        </div>
        <form action="{{ path('app_calculator_report_csv') }}" method="post" class="download-actions">
            <input type="hidden" name="_token" value="{{ csrf_token(csrf_token_id) }}">
            <input type="hidden" name="tax_year" value="{{ report.taxYear }}">
            <input type="hidden" name="expected_positions" value="{{ expected_positions }}">
            <input type="hidden" name="expected_dividends" value="{{ expected_dividends }}">
            {% for index, row in position_rows %}
                {% for key, value in row %}
                    <input type="hidden" name="positions[{{ index }}][{{ key }}]" value="{{ value }}">
                {% endfor %}
            {% endfor %}
            {% for index, row in dividend_rows %}
                {% for key, value in row %}
                    <input type="hidden" name="dividends[{{ index }}][{{ key }}]" value="{{ value }}">
                {% endfor %}
            {% endfor %}

            <button type="submit" class="button button--primary">Pobierz raport CSV</button>
            <button type="submit" class="button" formaction="{{ path('app_calculator_report_print') }}">
                Wersja do wydruku
            </button>
        </form>
    </section>

    {% include '_partials/report_details.html.twig' %}
{% endblock %}
