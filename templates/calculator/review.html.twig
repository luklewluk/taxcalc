{% extends 'base.html.twig' %}

{% block title %}Sprawdź wczytane dane — {{ app_name }}{% endblock %}

{% block container_class %}container container--wide{% endblock %}

{% block progress %}
    {% include '_partials/steps.html.twig' with {current: 2} only %}
{% endblock %}

{% block body %}
    <h1>Sprawdź dane</h1>
    <p class="lead">
        Popraw to, co wymaga korekty, i policz podatek. Dane istnieją wyłącznie w tym
        formularzu — odświeżenie strony je usunie.
    </p>

    {% include '_partials/messages.html.twig' %}

    {% if excluded_positions > 0 or excluded_dividends > 0 %}
        <p class="message message--info">
            Poza rokiem {{ selected_year }} zostaje {{ excluded_positions }} pozycji
            i {{ excluded_dividends }} dywidend — nie wejdą do rozliczenia.
            {% if available_years is not empty %}
                Wczytane dane obejmują lata:
                {% for year in available_years %}{{ year }}{{ not loop.last ? ', ' : '' }}{% endfor %}.
            {% endif %}
        </p>
    {% endif %}

    <form action="{{ path('app_calculator_result') }}" method="post" data-role="review">
        <input type="hidden" name="_token" value="{{ csrf_token(csrf_token_id) }}">
        {# Declared so the server can tell a truncated POST from a short one. #}
        <input type="hidden" name="expected_positions" value="{{ expected_positions }}">
        <input type="hidden" name="expected_dividends" value="{{ expected_dividends }}">

        <div class="review-bar">
            <div class="field--inline">
                <label for="tax_year">Rok podatkowy</label>
                <select id="tax_year" name="tax_year">
                    {% for year in tax_years %}
                        <option value="{{ year }}" {{ year == selected_year ? 'selected' : '' }}>{{ year }}</option>
                    {% endfor %}
                </select>
            </div>
            <p class="review-bar__counts">
                <span><b>{{ position_rows|length }}</b> pozycji zamkniętych</span>
                <span><b>{{ dividend_rows|length }}</b> dywidend</span>
            </p>
            <p class="review-bar__privacy">Dane tylko w tej karcie przeglądarki</p>
        </div>

        <input type="checkbox" id="show_tech" class="tech-toggle__input">
        <label for="show_tech" class="tech-toggle__label">Pokaż szczegóły techniczne</label>

        <div class="review-body">
            <section class="review-section" aria-labelledby="pozycje">
                <h2 id="pozycje">Pozycje zamknięte</h2>

                {% if position_rows is empty %}
                    <p class="note">Brak pozycji giełdowych do rozliczenia.</p>
                {% else %}
                    <div class="table-wrapper table-wrapper--editable">
                        <table class="table table--editable">
                            <thead>
                                <tr>
                                    <th scope="col">Instrument</th>
                                    <th scope="col">Kraj</th>
                                    <th scope="col">Zakup</th>
                                    <th scope="col">Sprzedaż</th>
                                    <th scope="col" class="cell--tech">Liczba</th>
                                    <th scope="col" class="cell--tech">Źródło</th>
                                    <th scope="col">Usuń</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for index, row in position_rows %}
                                    <tr{{ row.country == '' ? ' class="row--needs-attention"' : '' }}>
                                        <td class="cell--instrument" data-label="Instrument">
                                            <div class="cell-group">
                                                <span class="row-ordinal" aria-hidden="true">{{ index + 1 }}</span>
                                                <label class="visually-hidden" for="p{{ index }}_name">Instrument, wiersz {{ index + 1 }}</label>
                                                <input id="p{{ index }}_name" class="input--name" type="text" name="positions[{{ index }}][name]" value="{{ row.name }}" required>
                                                <input class="input--currency" type="text" name="positions[{{ index }}][currency]" value="{{ row.currency }}" size="4" aria-label="Waluta, wiersz {{ index + 1 }}" required>
                                            </div>
                                        </td>
                                        <td class="cell--country" data-label="Kraj">
                                            <label class="visually-hidden" for="p{{ index }}_country">Kraj, wiersz {{ index + 1 }}</label>
                                            <select id="p{{ index }}_country" name="positions[{{ index }}][country]" required aria-required="true">
                                                <option value="" {{ row.country == '' ? 'selected' : '' }}>— wybierz —</option>
                                                {% for code, name in countries %}
                                                    <option value="{{ code }}" {{ row.country == code ? 'selected' : '' }}>{{ code }} — {{ name }}</option>
                                                {% endfor %}
                                                {% if row.country != '' and row.country not in countries|keys %}
                                                    <option value="{{ row.country }}" selected>{{ row.country }}</option>
                                                {% endif %}
                                            </select>
                                            {% if row.country == '' %}
                                                <span class="needs-country">Do uzupełnienia</span>
                                            {% endif %}
                                        </td>
                                        <td data-label="Zakup">
                                            <div class="cell-group cell-group--pair">
                                                <input class="input--date" type="date" name="positions[{{ index }}][buy_date]" value="{{ row.buy_date }}" aria-label="Data zakupu, wiersz {{ index + 1 }}" required>
                                                <input class="input--amount" type="text" name="positions[{{ index }}][buy_amount]" value="{{ row.buy_amount }}" aria-label="Kwota zakupu, wiersz {{ index + 1 }}" required>
                                            </div>
                                        </td>
                                        <td data-label="Sprzedaż">
                                            <div class="cell-group cell-group--pair">
                                                <input class="input--date" type="date" name="positions[{{ index }}][sell_date]" value="{{ row.sell_date }}" aria-label="Data sprzedaży, wiersz {{ index + 1 }}" required>
                                                <input class="input--amount" type="text" name="positions[{{ index }}][sell_amount]" value="{{ row.sell_amount }}" aria-label="Kwota sprzedaży, wiersz {{ index + 1 }}" required>
                                            </div>
                                        </td>
                                        <td class="cell--tech" data-label="Liczba">
                                            <input class="input--quantity" type="text" name="positions[{{ index }}][quantity]" value="{{ row.quantity }}" aria-label="Liczba, wiersz {{ index + 1 }}">
                                        </td>
                                        <td class="cell--tech cell--source" data-label="Źródło">
                                            {{ row.source }}
                                            <input type="hidden" name="positions[{{ index }}][source]" value="{{ row.source }}">
                                        </td>
                                        <td class="cell--remove" data-label="Usuń">
                                            {#
                                                The label is the tap target: it wraps the box, so on a
                                                phone the whole 44x44 area toggles the row, and it names
                                                the control for a screen reader at the same time.
                                            #}
                                            <label class="remove-toggle">
                                                <input type="checkbox" name="positions[{{ index }}][remove]" value="1">
                                                <span class="visually-hidden">Usuń pozycję {{ index + 1 }}</span>
                                            </label>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </section>

            <section class="review-section" aria-labelledby="dywidendy">
                <h2 id="dywidendy">Dywidendy</h2>

                {% if dividend_rows is empty %}
                    <p class="note">Brak dywidend do rozliczenia.</p>
                {% else %}
                    <div class="table-wrapper table-wrapper--editable">
                        <table class="table table--editable">
                            <thead>
                                <tr>
                                    <th scope="col">Instrument</th>
                                    <th scope="col">Kraj</th>
                                    <th scope="col">Data</th>
                                    <th scope="col">Brutto</th>
                                    <th scope="col">Podatek u źródła</th>
                                    <th scope="col" class="cell--tech">Źródło</th>
                                    <th scope="col">Usuń</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for index, row in dividend_rows %}
                                    <tr{{ row.country == '' ? ' class="row--needs-attention"' : '' }}>
                                        <td class="cell--instrument" data-label="Instrument">
                                            <div class="cell-group">
                                                <span class="row-ordinal" aria-hidden="true">{{ index + 1 }}</span>
                                                <label class="visually-hidden" for="d{{ index }}_name">Instrument dywidendy, wiersz {{ index + 1 }}</label>
                                                <input id="d{{ index }}_name" class="input--name" type="text" name="dividends[{{ index }}][name]" value="{{ row.name }}" required>
                                                <input class="input--currency" type="text" name="dividends[{{ index }}][currency]" value="{{ row.currency }}" size="4" aria-label="Waluta dywidendy, wiersz {{ index + 1 }}" required>
                                            </div>
                                        </td>
                                        <td class="cell--country" data-label="Kraj">
                                            <label class="visually-hidden" for="d{{ index }}_country">Kraj dywidendy, wiersz {{ index + 1 }}</label>
                                            <select id="d{{ index }}_country" name="dividends[{{ index }}][country]" required aria-required="true">
                                                <option value="" {{ row.country == '' ? 'selected' : '' }}>— wybierz —</option>
                                                {% for code, name in countries %}
                                                    <option value="{{ code }}" {{ row.country == code ? 'selected' : '' }}>{{ code }} — {{ name }}</option>
                                                {% endfor %}
                                                {% if row.country != '' and row.country not in countries|keys %}
                                                    <option value="{{ row.country }}" selected>{{ row.country }}</option>
                                                {% endif %}
                                            </select>
                                            {% if row.country == '' %}
                                                <span class="needs-country">Do uzupełnienia</span>
                                            {% endif %}
                                        </td>
                                        <td data-label="Data">
                                            <input class="input--date" type="date" name="dividends[{{ index }}][date]" value="{{ row.date }}" aria-label="Data wypłaty, wiersz {{ index + 1 }}" required>
                                        </td>
                                        <td data-label="Brutto">
                                            <input class="input--amount" type="text" name="dividends[{{ index }}][gross]" value="{{ row.gross }}" aria-label="Kwota brutto, wiersz {{ index + 1 }}" required>
                                        </td>
                                        <td data-label="Podatek">
                                            <input class="input--amount" type="text" name="dividends[{{ index }}][tax_paid]" value="{{ row.tax_paid }}" aria-label="Podatek u źródła, wiersz {{ index + 1 }}">
                                        </td>
                                        <td class="cell--tech cell--source" data-label="Źródło">
                                            {{ row.source }}
                                            <input type="hidden" name="dividends[{{ index }}][source]" value="{{ row.source }}">
                                        </td>
                                        <td class="cell--remove" data-label="Usuń">
                                            <label class="remove-toggle">
                                                <input type="checkbox" name="dividends[{{ index }}][remove]" value="1">
                                                <span class="visually-hidden">Usuń dywidendę {{ index + 1 }}</span>
                                            </label>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </section>
        </div>

        <div class="action-bar">
            <button type="submit" class="button button--primary button--large">Oblicz podatek</button>
            <button type="submit" class="button button--quiet" formaction="{{ path('app_calculator_report_csv') }}">Pobierz CSV</button>
            <span class="action-bar__spacer"></span>
            <a class="button button--plain" href="{{ path('app_calculator', {rok: selected_year}) }}">Wgraj inne pliki</a>
        </div>
    </form>
{% endblock %}
