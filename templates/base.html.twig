<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="index, follow">
    <meta name="description" content="{% block meta_description %}Policz PIT-38 z akcji, opcji i dywidend w kilka minut. Za darmo, bez zakładania konta — wystarczy zestawienie z IBKR lub DEGIRO.{% endblock %}">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#f7f5f0" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0c0e0b" media="(prefers-color-scheme: dark)">
    <script src="{{ asset('js/theme.js') }}"></script>
    <title>{% block title %}{{ app_name }}{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    <link rel="stylesheet" href="{{ asset('css/print.css') }}" media="print">
    <link rel="icon" href="{{ asset('favicon.ico') }}" sizes="any">
    <link rel="icon" type="image/png" href="{{ asset('img/brand/favicon-32.png') }}" sizes="32x32">
    <link rel="apple-touch-icon" href="{{ asset('img/brand/apple-touch-icon.png') }}">
    {% if app_public_url and app.request and app.request.method == 'GET' %}
        {% set public_url = app_public_url|trim('/', 'right') %}
        <link rel="canonical" href="{{ public_url ~ app.request.pathInfo }}">
        <meta property="og:type" content="website">
        <meta property="og:site_name" content="{{ app_name }}">
        <meta property="og:title" content="{{ block('title') }}">
        <meta property="og:description" content="{{ block('meta_description') }}">
        <meta property="og:url" content="{{ public_url ~ app.request.pathInfo }}">
        <meta property="og:image" content="{{ public_url }}/img/brand/og-image.png">
        <meta property="og:locale" content="pl_PL">
        <meta name="twitter:card" content="summary_large_image">
    {% endif %}
</head>
<body>
<a class="skip-link" href="#tresc">Przejdź do treści</a>

{# The current route drives aria-current; the error page renders without one. #}
{% set current_route = app.request is not null ? app.current_route : null %}

<header class="site-header">
    <div class="container site-header__inner">
        <a class="site-header__brand" href="{{ path('app_home') }}">
            <img class="brand-mark" src="{{ asset('img/brand/taxcalc-icon.png') }}" width="26" height="26" alt="">
            {{ app_name }}
        </a>
        <nav aria-label="Nawigacja główna">
            <ul class="site-nav">
                <li><a href="{{ path('app_home') }}"{{ current_route == 'app_home' ? ' aria-current="page"' : '' }}>Start</a></li>
                <li><a href="{{ path('app_files_guide') }}"{{ current_route == 'app_files_guide' ? ' aria-current="page"' : '' }}>Skąd wziąć pliki</a></li>
                {% if app_repository_url %}
                    <li><a href="{{ app_repository_url|trim('/', 'right') }}/issues" rel="noopener noreferrer">Zgłoś problem</a></li>
                {% endif %}
            </ul>
        </nav>
        {# One round button: the system theme until the first click, then light or dark. #}
        <button type="button" class="theme-toggle" data-role="theme-toggle" data-theme-state="auto"
                aria-label="Motyw: automatyczny (jak w systemie). Przełącz motyw." title="Przełącz motyw" hidden>
            <svg data-icon="auto" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2"/>
                <path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"/>
            </svg>
            <svg data-icon="light" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                <circle cx="12" cy="12" r="4" fill="currentColor"/>
                <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"
                      fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <svg data-icon="dark" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                <path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7z" fill="currentColor"/>
            </svg>
        </button>
    </div>
</header>

<main id="tresc" class="{% block container_class %}container{% endblock %}">
    {% block progress %}{% endblock %}
    {% block body %}{% endblock %}
</main>

<footer class="site-footer">
    <div class="container">
        <div class="site-footer__grid">
            <p class="disclaimer" role="note">
                Narzędzie pomocnicze — nie stanowi porady podatkowej. Wyniki warto zestawić
                z aktualnymi przepisami oraz formularzami PIT-38 i PIT/ZG.
            </p>
            <p>
                {{ app_name }} — open source, licencja MIT. Twoje dane nie są nigdzie zapisywane.
                {% if app_repository_url %}
                    <a href="{{ app_repository_url }}" rel="noopener noreferrer">Repozytorium</a>.
                {% endif %}
            </p>
        </div>
    </div>
</footer>

{% block javascripts %}
    <script src="{{ asset('js/app.js') }}" defer></script>
{% endblock %}
</body>
</html>
