{% if report is not null and report.dividends.dividends is not empty %}
    {% set dividends = report.dividends %}
    {% set chosen = settings.creditMethod %}
    <div class="dividend-summary">
        <div class="panel-heading">
            <div>
                <h3>Podsumowanie dywidend</h3>
                <p class="note">
                    Liczby, z których powstają pola PIT-38 część G, w wariancie odliczenia
                    {{ chosen.shortLabel }} — zmienisz go w zakładce „Ustawienia”.
                </p>
            </div>
        </div>

        <div class="settings-grid">
            <section class="pit-card" aria-labelledby="dividend-pit-fields">
                <h3 id="dividend-pit-fields">Co trafia do PIT-38</h3>
                <dl class="pit-fields">
                    <div><dt>Pole {{ form_map.dividend_polish_tax }} — polski podatek 19%</dt><dd>{{ dividends.totalPolishTax|money }} zł</dd></div>
                    <div><dt>Pole {{ form_map.dividend_foreign_tax }} — pobrany za granicą</dt><dd>{{ dividends.totalWithheldTax|money }} zł</dd></div>
                    <div>
                        <dt>Pole {{ form_map.dividend_tax_due }} — do zapłaty</dt>
                        <dd>
                            {{ dividends.scenarioFor(chosen).taxDue|money }} zł
                            <span class="cell-note">wariant {{ chosen.shortLabel }}</span>
                        </dd>
                    </div>
                    <div>
                        <dt>Pole {{ form_map.total_tax }} — podatek łącznie (z akcjami)</dt>
                        <dd>
                            {{ report.totalTaxRoundedFor(chosen)|money }} zł
                            <span class="cell-note">w pełnych złotych, wariant {{ chosen.shortLabel }}</span>
                        </dd>
                    </div>
                </dl>
            </section>

            <section class="pit-card" aria-labelledby="dividend-totals">
                <h3 id="dividend-totals">Sumy</h3>
                <dl class="pit-fields">
                    <div><dt>Przychód brutto</dt><dd>{{ dividends.totalGross|money }} zł</dd></div>
                    <div><dt>Podatek polski 19%</dt><dd>{{ dividends.totalPolishTax|money }} zł</dd></div>
                    <div><dt>Podatek pobrany za granicą</dt><dd>{{ dividends.totalWithheldTax|money }} zł</dd></div>
                    <div><dt>Do odliczenia ({{ chosen.shortLabel }})</dt><dd>{{ dividends.scenarioFor(chosen).creditableTax|money }} zł</dd></div>
                    <div><dt>Do zapłaty w pełnych złotych</dt><dd>{{ dividends.scenarioFor(chosen).taxDueRoundedToZloty|money }} zł</dd></div>
                    <div><dt>Liczba wypłat</dt><dd>{{ dividends.dividends|length }}</dd></div>
                </dl>
                {% if report.excludedDividends > 0 %}
                    <p class="reconciliation">
                        Pominięto <strong>{{ report.excludedDividends }}</strong> wypłat(y) spoza roku
                        {{ report.taxYear }} — należą do rozliczenia tamtego roku.
                    </p>
                {% endif %}
            </section>
        </div>

        {% if dividends.countries is not empty %}
            <div class="table-wrapper">
                <table class="table table--detail dividend-countries">
                    <caption class="note">
                        Według kraju — audyt odliczenia, <strong>bez PIT/ZG</strong>: dywidendy rozlicza się
                        ryczałtem z art. 30a w części G, a kraj wyznacza wyłącznie limit stawki umownej.
                    </caption>
                    <thead><tr>
                        <th>Kraj</th><th>Przychód brutto</th><th>Pobrany za granicą</th><th>Podatek polski 19%</th>
                        <th>Do odliczenia ({{ chosen.shortLabel }})</th><th>Do zapłaty ({{ chosen.shortLabel }})</th>
                    </tr></thead>
                    <tbody>
                    {% for country in dividends.countries %}
                        {% set credit = country.creditFor(chosen) %}
                        <tr>
                            <th>{{ country.countryCode }}{{ country.countryName ? ' — ' ~ country.countryName : '' }}</th>
                            <td>{{ country.gross|money }}</td>
                            <td>{{ country.withheldTax|money }}</td>
                            <td>{{ country.polishTax|money }}</td>
                            <td>{{ credit.creditableTax|money }}</td>
                            <td>{{ credit.taxDue|money }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endif %}
