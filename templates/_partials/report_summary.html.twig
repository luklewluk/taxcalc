{#
    What the user came for: the amount, and the four figures a PIT-38 asks for.
    Everything explanatory lives in report_details.html.twig.
#}
{% set stock = report.stock %}
{% set dividends = report.dividends %}

<section class="verdict" aria-labelledby="podatek">
    <h2 id="podatek">Szacowany podatek za {{ report.taxYear }}</h2>

    {% if report.scenariosDiffer %}
        <p class="verdict__caption">
            Kwota zależy od tego, ile podatku pobranego za granicą odliczysz. Stan prawny jest sporny,
            więc kalkulator pokazuje obie wysokości.
        </p>
        <div class="verdict__pair">
            <div>
                <p class="verdict__label">Wariant zachowawczy (KIS)</p>
                <span class="verdict__amount">{{ report.totalTaxConservative|money }}<span class="verdict__unit">zł</span></span>
                <p class="verdict__sub">W zeznaniu: {{ report.totalTaxConservativeRounded|money }} zł</p>
            </div>
            <div>
                <p class="verdict__label">Wariant wg orzecznictwa NSA</p>
                <span class="verdict__amount">{{ report.totalTaxNsa|money }}<span class="verdict__unit">zł</span></span>
                <p class="verdict__sub">W zeznaniu: {{ report.totalTaxNsaRounded|money }} zł</p>
            </div>
        </div>
        <p class="verdict__note">
            Różnica to {{ report.scenarioDifference|money }} zł. Kalkulator nie rozstrzyga sporu —
            wybór i jego uzasadnienie należą do Ciebie.
        </p>
    {% else %}
        <p class="verdict__caption">Do zapłaty w Polsce za rok {{ report.taxYear }}.</p>
        <div class="verdict__pair">
            <div>
                <p class="verdict__label">Podatek łącznie</p>
                <span class="verdict__amount">{{ report.totalTaxConservative|money }}<span class="verdict__unit">zł</span></span>
                <p class="verdict__sub">W zeznaniu: {{ report.totalTaxConservativeRounded|money }} zł</p>
            </div>
        </div>
        <p class="verdict__note">
            Oba warianty odliczenia podatku zagranicznego dają tu ten sam wynik, więc nie musisz
            wybierać między nimi.
        </p>
    {% endif %}
</section>

<div class="figures-grid">
    <div class="figure">
        <span class="figure__label">Przychód ze sprzedaży</span>
        <span class="figure__value">{{ stock.totalRevenue|money }}</span>
    </div>
    <div class="figure">
        <span class="figure__label">Koszty uzyskania przychodu</span>
        <span class="figure__value">{{ stock.totalCost|money }}</span>
    </div>
    <div class="figure{{ stock.isLoss ? ' figure--negative' : '' }}">
        <span class="figure__label">{{ stock.isLoss ? 'Strata ze sprzedaży' : 'Dochód ze sprzedaży' }}</span>
        <span class="figure__value">{{ stock.isLoss ? (stock.loss|money) : (stock.income|money) }}</span>
    </div>
    <div class="figure">
        <span class="figure__label">Dywidendy brutto</span>
        <span class="figure__value">{{ dividends.totalGross|money }}</span>
    </div>
</div>

<p class="quiet">
    Wszystkie kwoty w złotych (zł).
    {% if stock.isLoss %}
        Strata nie generuje podatku; możesz ją rozliczyć w kolejnych latach — kalkulator nie
        śledzi strat z lat ubiegłych.
    {% endif %}
</p>

{#
    Notes come after the figures on purpose: they explain the numbers above, and
    a screen of paragraphs before the amount would bury what the user came for.
#}
{% if report.errors is not empty or report.warnings is not empty or report.hasExclusions %}
    <div class="messages messages--after" role="status">
        {% for message in report.errors %}
            <p class="message message--error"><strong>Błąd:</strong> {{ message }}</p>
        {% endfor %}

        {% if report.hasExclusions %}
            <p class="message message--info">
                Pominięto {{ report.excludedPositions }} pozycji i {{ report.excludedDividends }} dywidend
                spoza roku {{ report.taxYear }}.
            </p>
        {% endif %}

        {% if report.warnings|length == 1 %}
            <p class="message message--warning">{{ report.warnings|first }}</p>
        {% elseif report.warnings is not empty %}
            <details class="message-group"{{ expanded is defined and expanded ? ' open' : '' }}>
                <summary>Uwagi do wyliczenia ({{ report.warnings|length }})</summary>
                <div class="message-group__body">
                    {% for message in report.warnings %}
                        <p class="message message--warning">{{ message }}</p>
                    {% endfor %}
                </div>
            </details>
        {% endif %}
    </div>
{% endif %}
