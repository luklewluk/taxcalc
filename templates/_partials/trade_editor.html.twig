<div class="table-wrapper table-wrapper--editable">
    <table class="table table--editable trade-editor">
        <thead><tr>
            <th>Broker / pula FIFO</th><th>Instrument</th><th>Kraj</th><th>Data i czas</th><th>Kierunek</th>
            <th>Liczba</th><th>Cena wykonania</th><th>Waluta / Total</th><th>Prowizja</th><th>AutoFX</th><th>Źródło</th><th>Usuń</th>
        </tr></thead>
        <tbody data-editor-body="trades">
        {% for index, row in trade_rows %}
            {% set country_group = trade_country_groups[index] ?? {group_id: '', empty_count: 0} %}
            <tr id="row-{{ row.id }}" data-row-id="{{ row.id }}" data-country-group="{{ country_group.group_id }}">
                <td data-label="Broker / pula FIFO">
                    <input type="hidden" name="trades[{{ index }}][id]" value="{{ row.id }}">
                    {% if row.exchange %}<input type="hidden" name="trades[{{ index }}][exchange]" value="{{ row.exchange }}">{% endif %}
                    <label class="visually-hidden" for="t{{ index }}_broker">Broker</label>
                    <input id="t{{ index }}_broker" name="trades[{{ index }}][broker]" value="{{ row.broker }}" size="9" required>
                    <label class="visually-hidden" for="t{{ index }}_pool">Pula FIFO</label>
                    <input id="t{{ index }}_pool" name="trades[{{ index }}][pool]" value="{{ row.pool }}" size="14" required>
                </td>
                <td data-label="Instrument">
                    <input name="trades[{{ index }}][symbol]" value="{{ row.symbol }}" aria-label="Symbol, wiersz {{ index + 1 }}" size="12" required>
                    <input name="trades[{{ index }}][name]" value="{{ row.name }}" aria-label="Nazwa, wiersz {{ index + 1 }}" size="20" required>
                    <select name="trades[{{ index }}][asset]" aria-label="Rodzaj instrumentu, wiersz {{ index + 1 }}"><option value="STK" {{ row.asset != 'OPT' ? 'selected' : '' }}>Akcje / ETF</option><option value="OPT" {{ row.asset == 'OPT' ? 'selected' : '' }}>Opcja</option></select>
                </td>
                <td data-label="Kraj">
                    <select name="trades[{{ index }}][country]" aria-label="Kraj, wiersz {{ index + 1 }}" required aria-required="true">
                        <option value="">— wybierz —</option>
                        {% for code, name in country_options %}<option value="{{ code }}" {{ row.country == code ? 'selected' : '' }}>{{ code }} — {{ name }}</option>{% endfor %}
                    </select>
                    {% if row.country == '' and country_group.empty_count > 0 %}
                        <span class="needs-country">Brak kraju w {{ country_group.empty_count }} transakcj{{ country_group.empty_count == 1 ? 'i' : 'ach' }} tej puli</span>
                        <button type="submit" class="button button--link bulk-country"
                                name="bulk_country" value="{{ index }}" formnovalidate data-bulk-country>
                            Ustaw w pozostałych pustych transakcjach
                        </button>
                    {% endif %}
                </td>
                <td data-label="Data i czas">
                    <input type="date" name="trades[{{ index }}][date]" value="{{ row.date }}" aria-label="Data, wiersz {{ index + 1 }}" required>
                    <input type="time" step="1" name="trades[{{ index }}][time]" value="{{ row.time }}" aria-label="Czas, wiersz {{ index + 1 }}">
                </td>
                <td data-label="Kierunek"><select name="trades[{{ index }}][side]" aria-label="Kierunek, wiersz {{ index + 1 }}"><option value="BUY" {{ row.side == 'BUY' ? 'selected' : '' }}>Kupno</option><option value="SELL" {{ row.side == 'SELL' ? 'selected' : '' }}>Sprzedaż</option></select><select name="trades[{{ index }}][effect]" aria-label="Otwarcie lub zamknięcie opcji, wiersz {{ index + 1 }}"><option value="" {{ row.effect == '' ? 'selected' : '' }}>— (akcje)</option><option value="open" {{ row.effect == 'open' ? 'selected' : '' }}>Otwarcie</option><option value="close" {{ row.effect == 'close' ? 'selected' : '' }}>Zamknięcie</option><option value="close_open" {{ row.effect == 'close_open' ? 'selected' : '' }}>Zamknięcie i otwarcie</option></select></td>
                <td data-label="Liczba"><input name="trades[{{ index }}][quantity]" value="{{ row.quantity }}" size="9" inputmode="decimal" required></td>
                <td data-label="Cena wykonania"><input name="trades[{{ index }}][unit_price]" value="{{ row.unit_price }}" size="12" inputmode="decimal" aria-label="Cena wykonania, wiersz {{ index + 1 }}" placeholder="—"><input name="trades[{{ index }}][price_currency]" value="{{ row.price_currency }}" size="4" aria-label="Waluta ceny, wiersz {{ index + 1 }}" placeholder="waluta"></td>
                <td data-label="Waluta / Total"><input name="trades[{{ index }}][currency]" value="{{ row.currency }}" size="4" aria-label="Waluta, wiersz {{ index + 1 }}" required><input name="trades[{{ index }}][total]" value="{{ row.total }}" size="12" inputmode="decimal" aria-label="Total lub NetCash, wiersz {{ index + 1 }}" required></td>
                <td data-label="Prowizja"><input name="trades[{{ index }}][commission]" value="{{ row.commission }}" size="9" inputmode="decimal" aria-label="Prowizja, wiersz {{ index + 1 }}" placeholder="—"></td>
                <td data-label="AutoFX"><input name="trades[{{ index }}][autofx]" value="{{ row.autofx }}" size="9" inputmode="decimal" aria-label="AutoFX, wiersz {{ index + 1 }}" placeholder="—"></td>
                <td data-label="Źródło" class="cell--source">{{ row.source ?: 'ręcznie' }}<input type="hidden" name="trades[{{ index }}][source]" value="{{ row.source }}"><input type="hidden" name="trades[{{ index }}][external_id]" value="{{ row.external_id }}"></td>
                <td data-label="Usuń"><label class="remove-toggle"><input type="checkbox" name="trades[{{ index }}][remove]" value="1"><span class="visually-hidden">Usuń transakcję {{ index + 1 }}</span></label></td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% if trade_rows is empty %}<p class="note">Brak logicznych transakcji kupna lub sprzedaży.</p>{% endif %}
<p class="note">
    Opcje: wybierz „Opcja” i wskaż, czy transakcja otwiera, czy zamyka pozycję. Wygaśnięcie i przydział
    to zamknięcie z kwotą Total 0 i bez prowizji.
</p>

<template data-row-template="trades">
    <tr data-row-id="">
        <td data-label="Broker / pula FIFO"><input type="hidden" name="trades[__INDEX__][id]" value=""><input name="trades[__INDEX__][broker]" value="Ręczne" size="9" aria-label="Broker" required><input name="trades[__INDEX__][pool]" value="" size="14" aria-label="Pula FIFO" required></td>
        <td data-label="Instrument"><input name="trades[__INDEX__][symbol]" value="" size="12" aria-label="Symbol" required><input name="trades[__INDEX__][name]" value="" size="20" aria-label="Nazwa" required><select name="trades[__INDEX__][asset]" aria-label="Rodzaj instrumentu"><option value="STK">Akcje / ETF</option><option value="OPT">Opcja</option></select></td>
        <td data-label="Kraj"><select name="trades[__INDEX__][country]" aria-label="Kraj" required aria-required="true"><option value="">— wybierz —</option>{% for code, name in country_options %}<option value="{{ code }}">{{ code }} — {{ name }}</option>{% endfor %}</select></td>
        <td data-label="Data i czas"><input type="date" name="trades[__INDEX__][date]" aria-label="Data" required><input type="time" step="1" name="trades[__INDEX__][time]" aria-label="Czas"></td>
        <td data-label="Kierunek"><select name="trades[__INDEX__][side]" aria-label="Kierunek"><option value="BUY">Kupno</option><option value="SELL">Sprzedaż</option></select><select name="trades[__INDEX__][effect]" aria-label="Otwarcie lub zamknięcie opcji"><option value="">— (akcje)</option><option value="open">Otwarcie</option><option value="close">Zamknięcie</option><option value="close_open">Zamknięcie i otwarcie</option></select></td>
        <td data-label="Liczba"><input name="trades[__INDEX__][quantity]" size="9" inputmode="decimal" aria-label="Liczba" required></td>
        <td data-label="Cena wykonania"><input name="trades[__INDEX__][unit_price]" size="12" inputmode="decimal" aria-label="Cena wykonania" placeholder="—"><input name="trades[__INDEX__][price_currency]" size="4" aria-label="Waluta ceny" placeholder="waluta"></td>
        <td data-label="Waluta / Total"><input name="trades[__INDEX__][currency]" size="4" aria-label="Waluta" required><input name="trades[__INDEX__][total]" size="12" inputmode="decimal" aria-label="Total lub NetCash" required></td>
        <td data-label="Prowizja"><input name="trades[__INDEX__][commission]" size="9" inputmode="decimal" aria-label="Prowizja" placeholder="—"></td>
        <td data-label="AutoFX"><input name="trades[__INDEX__][autofx]" size="9" inputmode="decimal" aria-label="AutoFX" placeholder="—"></td>
        <td data-label="Źródło" class="cell--source">ręcznie<input type="hidden" name="trades[__INDEX__][source]" value="ręcznie"><input type="hidden" name="trades[__INDEX__][external_id]" value=""></td>
        <td data-label="Usuń"><label class="remove-toggle"><input type="checkbox" name="trades[__INDEX__][remove]" value="1"><span class="visually-hidden">Usuń transakcję</span></label></td>
    </tr>
</template>
