{#
    Three-step progress indicator for the calculator flow.
    `current` is 1 (Wgraj), 2 (Sprawdź) or 3 (Wynik).
#}
<nav class="progress" aria-label="Postęp rozliczenia">
    <ol class="progress__list">
        {% for label in ['Wgraj', 'Sprawdź', 'Wynik'] %}
            {% set number = loop.index %}
            <li class="progress__step{{ number == current ? ' is-current' : (number < current ? ' is-done' : '') }}"
                {% if number == current %}aria-current="step"{% endif %}>
                <span class="progress__num" aria-hidden="true">{{ number }}</span>
                <span class="progress__label">{{ label }}</span>
            </li>
        {% endfor %}
    </ol>
</nav>
