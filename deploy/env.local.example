# Production settings for TaxCalc.pl. On the server this file lives at
# <deploy_path>/shared/.env.local; Deployer links it into every release.
# Never commit the real one.

APP_ENV=prod
APP_DEBUG=0

# Generate once: php -r 'echo bin2hex(random_bytes(16)), PHP_EOL;'
APP_SECRET=

# Hostnames this instance answers to (regular expression).
TRUSTED_HOSTS='^(www\.)?example\.com$'
DEFAULT_URI=https://example.com

# Canonical link and Open Graph tags; leave empty to omit them.
APP_PUBLIC_URL=https://example.com
APP_REPOSITORY_URL=https://github.com/luklewluk/taxcalc
