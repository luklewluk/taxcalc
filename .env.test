# Environment used by the automated test suite.
KERNEL_CLASS='App\Kernel'
APP_SECRET='test_secret_not_used_in_production'
TRUSTED_HOSTS=''
DEFAULT_URI=http://localhost
# Tests never perform network calls; the rate provider is replaced by a fake
# (see config/services.yaml -> when@test). The URL below is only a placeholder.
NBP_API_BASE_URL=http://nbp.invalid/api/
SYMFONY_DEPRECATIONS_HELPER=max[self]=0
APP_DEBUG=0
