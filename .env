# Default environment values. Override locally with .env.local (never committed)
# or with real environment variables in production.
#
# DO NOT PUT PRODUCTION SECRETS IN THIS FILE.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_in_env_local_or_real_environment
TRUSTED_HOSTS=''
DEFAULT_URI=http://localhost:8000
###< symfony/framework-bundle ###

###> app ###
# Public NBP (Narodowy Bank Polski) exchange-rate API. No credentials required.
NBP_API_BASE_URL=https://api.nbp.pl/api/
# Shown in the page footer / README links.
APP_REPOSITORY_URL=https://github.com/luklewluk/taxcalc
# Public address used for the canonical link and Open Graph tags; leave empty
# on a self-hosted instance.
APP_PUBLIC_URL=https://taxcalc.pl
###< app ###
